{
  "$comment": "This file is yours; devos.config.json is generated from devos/engine.defaults.json and this file; edit here, then run node scripts/devos/config.mjs --write.",
  "project": "MAWSIM",
  "scenario": "new",
  "max_attempts": 1,
  "screens": {
    "pages": [
      "/ar",
      "/en"
    ]
  },
  "surfaces": {
    "builder": {
      "deny_extra": [
        "public/photos/**"
      ]
    }
  },
  "reviewer": {
    "deep_paths_extra": [
      "src/instrumentation.ts",
      "src/app/api/**"
    ]
  },
  "guards": {
    "i18n": {
      "catalogues": {
        "en": "src/i18n/messages/en.json",
        "ar": "src/i18n/messages/ar.json"
      }
    }
  },
  "structure": {
    "modules": {
      "produce": {
        "dir": "src/modules/produce",
        "public": [
          "src/modules/produce/index.ts"
        ]
      },
      "guide": {
        "dir": "src/modules/guide",
        "public": [
          "src/modules/guide/index.ts"
        ]
      },
      "home": {
        "dir": "src/modules/home",
        "public": [
          "src/modules/home/index.ts"
        ]
      }
    }
  },
  "agents": {
    "reviewer": {
      "id": "claude-deep",
      "tool": "claude",
      "model": "claude-opus-5-5"
    },
    "reviewer_light": {
      "id": "claude-light",
      "tool": "claude",
      "model": "claude-sonnet-5-5"
    },
    "pool": [
      {
        "id": "cursor-grok-4-7-xhigh-fast",
        "tool": "cursor",
        "model": "grok-4.7-xhigh-fast",
        "default": true,
        "note": "strengths: ui"
      }
    ],
    "policy": "always-default"
  },
  "ui": true,
  "stack": {
    "id": "next",
    "toolchain": "node",
    "manifest": "package.json",
    "commands": {
      "install": "pnpm install --frozen-lockfile",
      "typecheck": "pnpm run typecheck",
      "lint": "pnpm run lint",
      "test": "pnpm run test",
      "build": "pnpm run build"
    },
    "preview": "pnpm exec next start -H 127.0.0.1 -p {port}",
    "scaffold": {
      "create": [
        "pnpm create next-app@latest . --ts --eslint --app --src-dir --import-alias \"@/*\" --use-pnpm --yes"
      ],
      "health": "/api/health",
      "logger": "pino",
      "tests": "vitest",
      "architecture": "code under src/domain imports nothing from the framework, the database client or src/app",
      "modules": {
        "dir": "src/modules/<name>",
        "public": [
          "src/modules/<name>/index.ts"
        ]
      }
    }
  }
}
